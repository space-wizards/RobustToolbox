<!--
This is the MSBuild file that drives the creation of xml docs for use by View Variables.

Normally this is invoked from `Robust.Properties.targets` when a csproj defines `<ViewVariables>`
in its `<PropertyGroup>`.

The workflow is:

0. Ensure the XmlDocTool is built before any project that uses this system
1. Make sure the doc folder exists:
   - `..\Resources\ViewVariables\` for client and shared code, which is shipped to clients.
   - `..\Resources\Server\ViewVariables\` for server code, which only the server can see.
     The server hands these docs to clients that are allowed to VV, on demand.
2. Get MSBuild to generate the xml doc at the path from step 1.
3. Run XmlDocTool on the generated doc

Step two avoids using `<DocumentationFile>` due to a weird quirk of how that facility
works. DocumentationFile always causes two copies of the generated xml file to be
created, one at the path in DocumentationFile and one next to the DLL. This script
uses the somewhat arcane facility `<DocFileItem>` to side-step that problem and create
a single copy of the xml docs in the folder we want.

Project files (.csproj), inside or outside Robust Toolbox, opt in with:

```
  <PropertyGroup>
    <ViewVariables>true</ViewVariables>
  </PropertyGroup>
```

Projects whose name ends in `.Server` are treated as server-only automatically.
Override that with `<ViewVariablesServerOnly>true|false</ViewVariablesServerOnly>`.

see also
github.com/dotnet/msbuild/issues/1559
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Robust Toolbox root, found relative to this file so it works from content projects too -->
    <VVRobustDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</VVRobustDir>
    <!-- Doc generation is only enabled to feed VV, we don't require every public member to be documented -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Server code docs must not ship to clients, they go in the server-only resources folder -->
    <ViewVariablesServerOnly Condition="'$(ViewVariablesServerOnly)' == '' And $(MSBuildProjectName.EndsWith('.Server'))">true</ViewVariablesServerOnly>
    <VVDocDir Condition="'$(ViewVariablesServerOnly)' == 'true'">..\Resources\Server\ViewVariables\</VVDocDir>
    <VVDocDir Condition="'$(ViewVariablesServerOnly)' != 'true'">..\Resources\ViewVariables\</VVDocDir>
    <VVDocPath>$(VVDocDir)$(MSBuildProjectName).xml</VVDocPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Add a reference to XmlDocTool so it always gets built before any project that needs it -->
    <ProjectReference Include="$(VVRobustDir)Robust.XmlDocTool\Robust.XmlDocTool.csproj">
      <!-- Don't copy the build artifacts from this project to the referencing project's output folder  -->
      <Private>false</Private>
      <!-- Indicate that the referencing project isn't actually meant to reference this project's assembly directly -->
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <!-- Build-time tools run on the host, not the target runtime -->
      <GlobalPropertiesToRemove>RuntimeIdentifier;RestoreRuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <Target Name="GenerateXmlDoc" BeforeTargets="CoreCompile">
    <!-- Ensure the destination folder for the docs exists -->
    <MakeDir Directories="$(VVDocDir)"/>
    <ItemGroup>
      <!-- Slightly arcane invocation of the MSBuild doc generation facility that bypasses the issue explained above -->
      <DocFileItem Include="$(VVDocPath)" />
    </ItemGroup>
  </Target>
  <Target Name="TrimXmlDoc" AfterTargets="PostBuildEvent">
    <!-- Run XmlDocTool on the generated doc file -->
    <!-- Run the dll through the dotnet host rather than relying on a platform-specific apphost existing -->
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$([MSBuild]::NormalizePath('$(VVRobustDir)', 'bin', 'XmlDocTool', 'Robust.XmlDocTool.dll'))&quot; &quot;$(VVDocPath)&quot;" />
  </Target>
</Project>
